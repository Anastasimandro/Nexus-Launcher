#!/system/bin/sh
# Controla el overlay que hace de Nexus el proveedor de Quickstep.
#
# Uso (como root):
#   nexus-quickstep status            estado del overlay, de la comprobación de Nexus y del vigilante
#   nexus-quickstep enable [--force]  pide aplicar el overlay en el próximo arranque (hay que reiniciar)
#   nexus-quickstep disable [--reboot]
#                                     deja de aplicarlo (efectivo al reiniciar; --reboot reinicia ya)
#   nexus-quickstep bound             ¿está SystemUI enlazado al servicio de Quickstep de Nexus?
#   nexus-quickstep guard             lo ejecuta el módulo en cada arranque (ver service.sh)
#
# El overlay (app.nexus.launcher.overlay.recents) cambia config_recentsComponentName para que
# SystemUI enlace con el TouchInteractionService de Nexus y los gestos del sistema (Inicio,
# recientes) los lleve Nexus.
#
# Es un overlay ESTÁTICO: el sistema solo lo tiene en cuenta si está en /product/overlay cuando
# arranca PackageManagerService, y no se puede activar ni desactivar en caliente. Por eso `enable` y
# `disable` solo crean o borran /data/adb/nexus_quickstep/enabled; post-fs-data.sh del módulo copia
# el APK a system/product/overlay/ en el arranque si ese archivo existe. Sin él, los gestos del
# sistema no cambian (estado de serie).
#
# `enable` se niega si Nexus no ha comprobado que Quickstep es compatible con este Android (archivo
# quickstep-probe.txt que escribe la app al arrancar) o si el vigilante ya tuvo que desactivar el
# overlay con esta misma versión de Nexus. --force se salta las dos cosas.
#
# El vigilante (`guard`): en cada arranque con el overlay aplicado espera a que SystemUI se enlace al
# servicio de Nexus. Si no ocurre, o el enlace se pierde y no vuelve, borra `enabled` y reinicia: el
# siguiente arranque va sin overlay y los gestos vuelven al launcher del sistema. No depende de que
# Nexus arranque. Si el sistema ni siquiera termina de arrancar, post-fs-data.sh lo detecta (marcador
# `booting`) y arranca sin overlay.

OVERLAY="app.nexus.launcher.overlay.recents"
PKG="app.nexus.launcher"
SERVICE="$PKG/com.android.quickstep.TouchInteractionService"
USER_ID=0
STATE_DIR="${NEXUS_STATE_DIR:-/data/adb/nexus_quickstep}"
MODDIR="${NEXUS_MODDIR:-/data/adb/modules/nexus_launcher_systemless}"
COMPONENT_KEY="android:string/config_recentsComponentName"
PROBE_FILE="${NEXUS_PROBE_FILE:-/data/user/$USER_ID/$PKG/files/quickstep-probe.txt}"
# Segundos que se espera el primer enlace, cuánto se vigila después y cada cuánto se mira.
GUARD_WAIT="${NEXUS_GUARD_WAIT:-180}"
GUARD_WATCH="${NEXUS_GUARD_WATCH:-300}"
GUARD_STEP="${NEXUS_GUARD_STEP:-5}"
# Segundos seguidos sin enlace durante la vigilancia a partir de los cuales se desactiva.
GUARD_LOST="${NEXUS_GUARD_LOST:-60}"

say() { echo "$*"; }
die() { echo "nexus-quickstep: $*" >&2; exit 1; }

log() {
  mkdir -p "$STATE_DIR" 2>/dev/null
  echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$STATE_DIR/watchdog.log" 2>/dev/null
}

usage() {
  say "Uso: nexus-quickstep status | enable [--force] | disable [--reboot] | bound"
  exit "${1:-2}"
}

need_root() {
  [ "$(id -u)" = "0" ] || die "hace falta root (su -c nexus-quickstep ...)."
}

# Estado del overlay en este arranque. Un overlay estático no sale en `cmd overlay list` (comprobado en
# Android 17), así que se mira el resultado: si config_recentsComponentName apunta a Nexus, está aplicado.
overlay_state() {
  if overlay_effective; then
    echo "aplicado (efectivo)"
  elif [ -n "$(applied_apk)" ]; then
    echo "APK puesto pero no efectivo"
  else
    echo "no aplicado"
  fi
}

# Valor de una clave del archivo de comprobación (vacío si no existe).
probe_value() {
  [ -r "$PROBE_FILE" ] || return 0
  sed -n "s/^$1=//p" "$PROBE_FILE" | head -n 1
}

# versionCode instalado de Nexus (vacío si no se puede leer).
nexus_version_code() {
  # Justo después de arrancar `dumpsys package` puede no responder: se reintenta y se prueba otra vía.
  n=0
  while [ "$n" -lt 5 ]; do
    v=$(dumpsys package "$PKG" 2>/dev/null | sed -n 's/.*versionCode=\([0-9][0-9]*\).*/\1/p' | head -n 1)
    [ -n "$v" ] && { echo "$v"; return 0; }
    v=$(cmd package list packages --show-versioncode "$PKG" 2>/dev/null | sed -n 's/.*versionCode:\([0-9][0-9]*\).*/\1/p' | head -n 1)
    [ -n "$v" ] && { echo "$v"; return 0; }
    n=$((n + 1)); sleep 1
  done
}

# Líneas del volcado del servicio que muestran a SystemUI enlazado (vacío si no lo está).
# Solo cuenta si el servicio llegó a entregar su binder ("received=true"): con el servicio caído al
# crearse, SystemUI sigue figurando como cliente pero con "binder=null received=false" (se vio en
# Android 17 cuando Nexus no tenía MANAGE_ACTIVITY_TASKS). Se ignora la sección de servicios en
# destrucción, que conserva registros viejos.
bound_lines() {
  dump=$(dumpsys activity services "$SERVICE" 2>/dev/null | sed '/Destroying services:/,$d')
  echo "$dump" | grep -q "received=true" || return 0
  echo "$dump" | grep -E "(AppBindRecord|ConnectionRecord).*com\.android\.systemui"
}

is_bound() {
  [ -n "$(bound_lines)" ]
}

boot_completed() {
  [ "$(getprop sys.boot_completed)" = "1" ]
}

# Componente de recientes que el sistema usa ahora.
current_recents() {
  cmd overlay lookup --user "$USER_ID" android "$COMPONENT_KEY" 2>/dev/null | head -n 1
}

# ¿Ha entrado el overlay en este arranque? (config_recentsComponentName apunta a Nexus)
overlay_effective() {
  case "$(current_recents)" in "$PKG"/*) return 0 ;; *) return 1 ;; esac
}

# Línea de `ls` del APK que el módulo ha puesto en /product/overlay (vacío si no está).
applied_apk() {
  ls -l /product/overlay/NexusRecentsOverlay.apk 2>/dev/null
}

show_status() {
  if [ -f "$STATE_DIR/enabled" ]; then
    say "Pedido (enabled): sí. El módulo aplica el overlay en cada arranque."
  else
    say "Pedido (enabled): no. El módulo no aplica el overlay (estado de serie)."
  fi
  [ -f "$MODDIR/overlay-static/NexusRecentsOverlay.apk" ] || say "  AVISO: el módulo no lleva overlay-static/NexusRecentsOverlay.apk."
  state=$(overlay_state)
  say "Overlay $OVERLAY en este arranque: $state"
  [ -n "$(applied_apk)" ] && say "  APK en /product/overlay: sí" || say "  APK en /product/overlay: no"
  value=$(current_recents)
  say "config_recentsComponentName ahora: ${value:-desconocido}"
  if overlay_effective; then
    say "Overlay efectivo: sí (Nexus es el proveedor de recientes)"
    if is_bound; then say "SystemUI enlazado al servicio de Nexus: sí"; else say "SystemUI enlazado al servicio de Nexus: NO"; fi
  else
    say "Overlay efectivo: no"
    if [ -f "$STATE_DIR/enabled" ] && [ -n "$(applied_apk)" ]; then
      say "  Está aplicado pero otro overlay de la imagen gana sobre él, o hay un overlay/config/config.xml."
    elif [ -f "$STATE_DIR/enabled" ]; then
      say "  Falta reiniciar (o el arranque anterior no llegó a aplicarlo)."
    fi
  fi
  if [ -r "$PROBE_FILE" ]; then
    say "Comprobación de Nexus: sdk=$(probe_value sdk) compatible=$(probe_value passed)"
    missing=$(probe_value missing)
    [ -n "$missing" ] && say "  Falta en este Android: $missing"
    tolerated=$(probe_value tolerated)
    [ -n "$tolerated" ] && say "  Ausente pero tolerado por Nexus: $tolerated"
    denied=$(probe_value denied)
    [ -n "$denied" ] && say "  Permisos de sistema aún no concedidos a Nexus: $denied"
  else
    say "Comprobación de Nexus: sin datos (abre Nexus una vez)."
  fi
  if [ -r "$STATE_DIR/tripped" ]; then
    say "Vigilante: desactivó el overlay -> $(cat "$STATE_DIR/tripped")"
  elif [ -e "$STATE_DIR/healthy" ]; then
    say "Vigilante: el último arranque con el overlay aplicado quedó verificado."
  else
    say "Vigilante: sin verificar todavía."
  fi
  [ -f "$STATE_DIR/booting" ] && say "Marcador de arranque (booting): presente (el vigilante lo borra al verificar el arranque)."
  say "Los cambios solo se aplican al reiniciar."
}

do_enable() {
  force=0
  [ "$1" = "--force" ] && force=1
  need_root
  [ -f "$MODDIR/overlay-static/NexusRecentsOverlay.apk" ] || die "el módulo no lleva el overlay: reflashea el módulo y reinicia."
  [ -f "$MODDIR/disable" ] && die "el módulo está desactivado en el gestor (archivo disable)."
  # Con un overlay/config/config.xml en /product los overlays estáticos de esa partición que no
  # aparezcan en él se ignoran, y los que sí se ignoran dejan de aplicarse: no se toca.
  if [ -e /product/overlay/config/config.xml ] && [ "$force" != "1" ]; then
    die "/product/overlay/config/config.xml existe: el sistema ignoraría un overlay estático que no esté en él. Con --force se prueba igualmente."
  fi
  version=$(nexus_version_code)
  if [ "$force" != "1" ]; then
    [ -r "$PROBE_FILE" ] || die "Nexus aún no ha comprobado la compatibilidad: ábrelo una vez (o usa --force)."
    passed=$(probe_value passed)
    if [ "$passed" != "true" ]; then
      missing=$(probe_value missing)
      die "Quickstep no es compatible con este Android (sdk=$(probe_value sdk); falta: ${missing:-?}). Con --force se activa igualmente, pero los gestos pueden dejar de funcionar."
    fi
    tripped_version=$(sed -n 's/^version=//p' "$STATE_DIR/tripped.meta" 2>/dev/null)
    if [ -r "$STATE_DIR/tripped" ] && { [ -z "$tripped_version" ] || [ -z "$version" ] || [ "$tripped_version" = "$version" ] || [ "$tripped_version" = "bootloop" ]; }; then
      die "el overlay se desactivó solo ($(cat "$STATE_DIR/tripped")). Tras un fallo de arranque o con esta versión de Nexus ($version) hace falta --force; si es solo la versión, actualizar Nexus también vale."
    fi
  fi
  mkdir -p "$STATE_DIR"
  rm -f "$STATE_DIR/tripped" "$STATE_DIR/tripped.meta" "$STATE_DIR/healthy" "$STATE_DIR/booting"
  echo "$(date '+%Y-%m-%d %H:%M:%S') version=$version" > "$STATE_DIR/enabled"
  say "Overlay pedido. REINICIA para que el sistema lo aplique en el arranque."
  say "Tras reiniciar: nexus-quickstep status  y  nexus-quickstep bound"
  say "Si SystemUI no llega a enlazarse con Nexus, el vigilante lo desactiva y reinicia solo."
  say "Para deshacerlo: nexus-quickstep disable --reboot"
}

do_disable() {
  need_root
  rm -f "$STATE_DIR/enabled" "$STATE_DIR/booting" "$STATE_DIR/healthy"
  # Se borra también la copia ya montada (por si el módulo no se reinicia limpio).
  rm -f "$MODDIR/system/product/overlay/NexusRecentsOverlay.apk" 2>/dev/null
  if [ "$1" = "--reboot" ]; then
    say "Overlay desactivado. Reiniciando: el gesto vuelve al launcher del sistema."
    reboot
  else
    say "Overlay desactivado para el próximo arranque. Reinicia para que los gestos vuelvan al launcher del sistema."
    say "(El overlay es estático: mientras no reinicies, Nexus sigue siendo el proveedor de recientes.)"
  fi
}

do_bound() {
  lines=$(bound_lines)
  if [ -n "$lines" ]; then
    say "SystemUI enlazado al servicio de Quickstep de Nexus: sí"
    say "$lines"
    exit 0
  fi
  say "SystemUI enlazado al servicio de Quickstep de Nexus: NO"
  say "(overlay efectivo: $(overlay_effective && echo sí || echo no); estado: $(overlay_state))"
  exit 1
}

# Quickstep de Nexus no funciona: se quita el archivo `enabled`, se deja constancia y se reinicia
# para que el siguiente arranque vaya sin overlay. No hay más reinicios: sin `enabled` el módulo
# no vuelve a aplicarlo, así que no puede haber un bucle.
trip() {
  reason="$1"
  log "DESACTIVO el overlay: $reason"
  mkdir -p "$STATE_DIR"
  echo "$(date '+%Y-%m-%d %H:%M:%S') $reason" > "$STATE_DIR/tripped"
  echo "version=$(nexus_version_code)" > "$STATE_DIR/tripped.meta"
  rm -f "$STATE_DIR/enabled" "$STATE_DIR/booting" "$STATE_DIR/healthy"
  if [ "${NEXUS_GUARD_NO_REBOOT:-0}" = "1" ]; then
    log "reinicio omitido (NEXUS_GUARD_NO_REBOOT=1)"
  else
    log "reiniciando para arrancar sin overlay"
    sleep 2
    reboot
  fi
}

do_guard() {
  if [ ! -f "$STATE_DIR/enabled" ]; then
    rm -f "$STATE_DIR/booting"
    log "arranque: overlay no pedido, nada que vigilar"
    exit 0
  fi
  log "arranque con el overlay pedido: vigilando (espera ${GUARD_WAIT}s, vigilancia ${GUARD_WATCH}s)"

  waited=0
  while ! boot_completed; do
    sleep "$GUARD_STEP"
    waited=$((waited + GUARD_STEP))
    [ "$waited" -ge 600 ] && { trip "el arranque no terminó en 600 s"; exit 0; }
  done

  # ¿Entró el overlay? Si otro overlay de la imagen gana, o no se aplicó, no hay nada que verificar:
  # no es un fallo de Quickstep y no se reinicia.
  if ! overlay_effective; then
    log "overlay pedido pero no efectivo ($(current_recents)): no se vigila"
    rm -f "$STATE_DIR/booting"
    exit 0
  fi

  # Primer enlace: SystemUI tarda en arrancar y en enlazar; se da un margen.
  waited=0
  while ! is_bound; do
    [ "$waited" -ge "$GUARD_WAIT" ] && { trip "SystemUI no se enlazó al servicio de Nexus en ${GUARD_WAIT} s"; exit 0; }
    sleep "$GUARD_STEP"
    waited=$((waited + GUARD_STEP))
  done
  log "SystemUI enlazado al servicio de Nexus tras ${waited}s"
  mkdir -p "$STATE_DIR"
  date '+%Y-%m-%d %H:%M:%S' > "$STATE_DIR/healthy"
  rm -f "$STATE_DIR/booting"

  # Vigilancia: si el servicio se cae justo después de arrancar y no vuelve, se desactiva.
  watched=0
  lost=0
  while [ "$watched" -lt "$GUARD_WATCH" ]; do
    sleep "$GUARD_STEP"
    watched=$((watched + GUARD_STEP))
    if is_bound; then
      lost=0
    else
      lost=$((lost + GUARD_STEP))
      [ "$lost" -ge "$GUARD_LOST" ] && { trip "se perdió el enlace con el servicio de Nexus durante ${GUARD_LOST} s"; exit 0; }
    fi
  done
  log "vigilancia terminada: enlace estable"
}

case "$1" in
  status) show_status ;;
  enable) do_enable "$2" ;;
  disable) do_disable "$2" ;;
  bound) do_bound ;;
  guard) need_root; do_guard ;;
  -h | --help | help) usage 0 ;;
  *) usage 2 ;;
esac
