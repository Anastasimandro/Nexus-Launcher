#!/system/bin/sh
# Controla el overlay que hace de Nexus el proveedor de Quickstep.
#
# Uso (como root):
#   nexus-quickstep status            estado del overlay, de la comprobación de Nexus y del vigilante
#   nexus-quickstep enable [--force]  pide aplicar el overlay en el próximo arranque (hay que reiniciar)
#   nexus-quickstep disable [--reboot]
#                                     deja de aplicarlo (efectivo al reiniciar; --reboot reinicia ya)
#   nexus-quickstep enable --umount-fix  además pone disable_umount = true en hybrid_mount (con copia;
#                                     se restaura si el overlay falla). Ver hybrid_apply
#   nexus-quickstep umount-fix on|restore|status   solo ese ajuste de hybrid_mount
#   nexus-quickstep bound             ¿está SystemUI enlazado al servicio de Quickstep de Nexus?
#   nexus-quickstep guard             lo ejecuta el módulo en cada arranque (ver service.sh)
#   nexus-quickstep state             estado en líneas clave=valor (lo lee el WebUI del módulo)
#   nexus-quickstep diag [--export]   informe de diagnóstico; --export lo deja en Descargas con los
#                                     registros del último arranque fallido
#   nexus-quickstep logs [segundos]  copia todos los registros a /sdcard/Nexus-Logs (RESUMEN.txt dice
#                                     en claro si el arranque fue bien o falló)
#   nexus-quickstep home-role status|on|off
#                                     poner o quitar a Nexus como app de Inicio (rol HOME) con `cmd role`.
#                                     Nunca se hace solo: solo a petición (botón del WebUI). Ver do_home_role
#   nexus-quickstep capture start|stop|keep
#                                     registro del arranque (lo usa post-fs-data.sh, ver abajo)
#
# El overlay (app.nexus.launcher.overlay.recents) cambia config_recentsComponentName para que
# SystemUI enlace con el TouchInteractionService de Nexus y los gestos del sistema (Inicio,
# recientes) los lleve Nexus.
#
# Es un overlay ESTÁTICO: el sistema solo lo tiene en cuenta si está en /product/overlay cuando
# arranca PackageManagerService, y no se puede activar ni desactivar en caliente. Por eso `enable` y
# `disable` solo crean o borran /data/adb/nexus_quickstep/enabled; post-fs-data.sh del módulo copia
# el APK a system/product/overlay/ en el arranque si ese archivo existe. Sin él, los gestos del
# sistema no cambian (estado de serie).
#
# `enable` se niega si Nexus no ha comprobado que Quickstep es compatible con este Android (archivo
# quickstep-probe.txt que escribe la app al arrancar) o si el vigilante ya tuvo que desactivar el
# overlay con esta misma versión de Nexus. --force se salta las dos cosas.
#
# El vigilante (`guard`): en cada arranque con el overlay aplicado espera a que SystemUI se enlace al
# servicio de Nexus. Si no ocurre, o el enlace se pierde y no vuelve, borra `enabled` y reinicia: el
# siguiente arranque va sin overlay y los gestos vuelven al launcher del sistema. No depende de que
# Nexus arranque. Si el sistema ni siquiera termina de arrancar, post-fs-data.sh lo detecta (marcador
# `booting`) y arranca sin overlay.

OVERLAY="app.nexus.launcher.overlay.recents"
PKG="app.nexus.launcher"
SERVICE="$PKG/com.android.quickstep.TouchInteractionService"
USER_ID=0
STATE_DIR="${NEXUS_STATE_DIR:-/data/adb/nexus_quickstep}"
MODDIR="${NEXUS_MODDIR:-/data/adb/modules/nexus_launcher_systemless}"
COMPONENT_KEY="android:string/config_recentsComponentName"
PROBE_FILE="${NEXUS_PROBE_FILE:-/data/user/$USER_ID/$PKG/files/quickstep-probe.txt}"
# Segundos que se espera el primer enlace, cuánto se vigila después y cada cuánto se mira.
GUARD_WAIT="${NEXUS_GUARD_WAIT:-180}"
GUARD_WATCH="${NEXUS_GUARD_WATCH:-300}"
GUARD_STEP="${NEXUS_GUARD_STEP:-5}"
# Segundos seguidos sin enlace durante la vigilancia a partir de los cuales se desactiva.
GUARD_LOST="${NEXUS_GUARD_LOST:-60}"
# Registro del arranque con el overlay aplicado y reinicio automático si el arranque se cuelga.
# El registro vive en capture/; si el arranque no termina, post-fs-data.sh lo copia a failed-boot/
# en el arranque siguiente (el que ya va sin overlay) para que se pueda exportar.
CAPTURE_DIR="$STATE_DIR/capture"
# /product se puede cambiar (NEXUS_PRODUCT_DIR) para probar la herramienta fuera de un móvil.
PRODUCT_DIR="${NEXUS_PRODUCT_DIR:-/product}"
OVERLAY_PATH="$PRODUCT_DIR/overlay/NexusRecentsOverlay.apk"
FAILED_DIR="$STATE_DIR/failed-boot"
BOOT_TIMEOUT="${NEXUS_BOOT_TIMEOUT:-360}"
EXPORT_DIR="${NEXUS_EXPORT_DIR:-/storage/emulated/0/Download}"
# Carpeta en el almacenamiento interno con todos los registros, para verlos sin comandos.
# El almacenamiento no está disponible hasta que se desbloquea el móvil tras arrancar: hasta entonces
# los registros se guardan en STATE_DIR y se copian aquí en cuanto se pueda.
LOGS_DIR="${NEXUS_LOGS_DIR:-/storage/emulated/0/Nexus-Logs}"
SDCARD_READY="${NEXUS_SDCARD_READY:-/storage/emulated/0/Android}"
# Ajuste opcional de hybrid_mount (metamódulo de KernelSU): ver hybrid_apply.
HYBRID_CONFIG="${NEXUS_HYBRID_CONFIG:-/data/adb/hybrid-mount/config.toml}"
HYBRID_BACKUP="$STATE_DIR/hybrid-config.orig"
HYBRID_MARK="$STATE_DIR/hybrid-changed"
# Historial de intentos (una línea por suceso: fecha|suceso|detalle) y carpeta de módulos de root.
HISTORY_FILE="$STATE_DIR/history.log"
MODULES_DIR="${NEXUS_MODULES_DIR:-/data/adb/modules}"

say() { echo "$*"; }
die() { echo "nexus-quickstep: $*" >&2; exit 1; }

log() {
  mkdir -p "$STATE_DIR" 2>/dev/null
  echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$STATE_DIR/watchdog.log" 2>/dev/null
}

usage() {
  say "Uso: nexus-quickstep status | enable [--force] [--umount-fix] | disable [--reboot] | bound | state | diag [--export] | logs | home-role status|on|off | umount-fix on|restore|status | preflight | history | sync-apk [--wait]"
  exit "${1:-2}"
}

need_root() {
  [ "$(id -u)" = "0" ] || die "hace falta root (su -c nexus-quickstep ...)."
}

# tmo SEGUNDOS comando [args...]: ejecuta un comando EXTERNO con límite de tiempo y devuelve su código
# (124, 137 o 143 si se cortó por tiempo). No sirve para funciones del script ni para builtins. Usa
# `timeout` (toybox/coreutils) si existe; si no, un temporizador propio con kill.
if command -v timeout >/dev/null 2>&1; then
  tmo() { t="$1"; shift; timeout -k 1 "$t" "$@"; }
else
  tmo() {
    t="$1"; shift
    "$@" &
    tp=$!
    ( sleep "$t"; kill "$tp" 2>/dev/null ) >/dev/null 2>&1 &
    tw=$!
    wait "$tp" 2>/dev/null
    trc=$?
    kill "$tw" 2>/dev/null
    return "$trc"
  }
fi

# Estado del overlay en este arranque. Un overlay estático no sale en `cmd overlay list` (comprobado en
# Android 17), así que se mira el resultado: si config_recentsComponentName apunta a Nexus, está aplicado.
overlay_state() {
  if overlay_effective; then
    echo "aplicado (efectivo)"
  elif [ -n "$(applied_apk)" ]; then
    echo "APK puesto pero no efectivo"
  else
    echo "no aplicado"
  fi
}

# Valor de una clave del archivo de comprobación (vacío si no existe).
probe_value() {
  [ -r "$PROBE_FILE" ] || return 0
  sed -n "s/^$1=//p" "$PROBE_FILE" | head -n 1
}

# versionCode instalado de Nexus (vacío si no se puede leer).
nexus_version_code() {
  # Justo después de arrancar `dumpsys package` puede no responder: se reintenta y se prueba otra vía.
  n=0
  while [ "$n" -lt 5 ]; do
    v=$(dumpsys package "$PKG" 2>/dev/null | sed -n 's/.*versionCode=\([0-9][0-9]*\).*/\1/p' | head -n 1)
    [ -n "$v" ] && { echo "$v"; return 0; }
    v=$(cmd package list packages --show-versioncode "$PKG" 2>/dev/null | sed -n 's/.*versionCode:\([0-9][0-9]*\).*/\1/p' | head -n 1)
    [ -n "$v" ] && { echo "$v"; return 0; }
    n=$((n + 1)); sleep 1
  done
}

# Líneas del volcado del servicio que muestran a SystemUI enlazado (vacío si no lo está).
# Solo cuenta si el servicio llegó a entregar su binder ("received=true"): con el servicio caído al
# crearse, SystemUI sigue figurando como cliente pero con "binder=null received=false" (se vio en
# Android 17 cuando Nexus no tenía MANAGE_ACTIVITY_TASKS). Se ignora la sección de servicios en
# destrucción, que conserva registros viejos.
bound_lines() {
  dump=$(dumpsys activity services "$SERVICE" 2>/dev/null | sed '/Destroying services:/,$d')
  echo "$dump" | grep -q "received=true" || return 0
  echo "$dump" | grep -E "(AppBindRecord|ConnectionRecord).*com\.android\.systemui"
}

is_bound() {
  [ -n "$(bound_lines)" ]
}

boot_completed() {
  [ "$(getprop sys.boot_completed)" = "1" ]
}

# Componente de recientes que el sistema usa ahora.
current_recents() {
  cmd overlay lookup --user "$USER_ID" android "$COMPONENT_KEY" 2>/dev/null | head -n 1
}

# ¿Ha entrado el overlay en este arranque? (config_recentsComponentName apunta a Nexus)
overlay_effective() {
  case "$(current_recents)" in "$PKG"/*) return 0 ;; *) return 1 ;; esac
}

# Línea de `ls` del APK que el módulo ha puesto en /product/overlay (vacío si no está).
applied_apk() {
  ls -l "$OVERLAY_PATH" 2>/dev/null
}

show_status() {
  if [ -f "$STATE_DIR/enabled" ]; then
    say "Pedido (enabled): sí. El módulo aplica el overlay en cada arranque."
  else
    say "Pedido (enabled): no. El módulo no aplica el overlay (estado de serie)."
  fi
  [ -f "$MODDIR/overlay-static/NexusRecentsOverlay.apk" ] || say "  AVISO: el módulo no lleva overlay-static/NexusRecentsOverlay.apk."
  state=$(overlay_state)
  say "Overlay $OVERLAY en este arranque: $state"
  [ -n "$(applied_apk)" ] && say "  APK en /product/overlay: sí" || say "  APK en /product/overlay: no"
  value=$(current_recents)
  say "config_recentsComponentName ahora: ${value:-desconocido}"
  if overlay_effective; then
    say "Overlay efectivo: sí (Nexus es el proveedor de recientes)"
    if is_bound; then say "SystemUI enlazado al servicio de Nexus: sí"; else say "SystemUI enlazado al servicio de Nexus: NO"; fi
  else
    say "Overlay efectivo: no"
    if [ -f "$STATE_DIR/enabled" ] && [ -n "$(applied_apk)" ]; then
      say "  Está aplicado pero otro overlay de la imagen gana sobre él, o hay un overlay/config/config.xml."
    elif [ -f "$STATE_DIR/enabled" ]; then
      say "  Falta reiniciar (o el arranque anterior no llegó a aplicarlo)."
    fi
  fi
  if [ -r "$PROBE_FILE" ]; then
    say "Comprobación de Nexus: sdk=$(probe_value sdk) compatible=$(probe_value passed)"
    missing=$(probe_value missing)
    [ -n "$missing" ] && say "  Falta en este Android: $missing"
    tolerated=$(probe_value tolerated)
    [ -n "$tolerated" ] && say "  Ausente pero tolerado por Nexus: $tolerated"
    denied=$(probe_value denied)
    [ -n "$denied" ] && say "  Permisos de sistema aún no concedidos a Nexus: $denied"
  else
    say "Comprobación de Nexus: sin datos (abre Nexus una vez)."
  fi
  if [ -r "$STATE_DIR/tripped" ]; then
    say "Vigilante: desactivó el overlay -> $(cat "$STATE_DIR/tripped")"
  elif [ -e "$STATE_DIR/healthy" ]; then
    say "Vigilante: el último arranque con el overlay aplicado quedó verificado."
  else
    say "Vigilante: sin verificar todavía."
  fi
  [ -f "$STATE_DIR/booting" ] && say "Marcador de arranque (booting): presente (el vigilante lo borra al verificar el arranque)."
  say "Los cambios solo se aplican al reiniciar."
}

# --- Ajuste de hybrid_mount: disable_umount = true ---
# Con hybrid_mount (y NeoZygisk) el overlay estático de recientes hacía abortar a zygote: la
# ocultación de root le quitaba el montaje del módulo y no podía reabrir el APK del overlay. En
# hybrid_mount, `disable_umount = true` hace que no oculte los montajes del módulo a las apps (lo
# citan como solución en Hybrid-Mount/meta-hybrid_mount#497). Es una PRUEBA: no está demostrado que
# baste en este móvil, y debilita un poco la ocultación de root (Play Integrity).
# Se guarda una copia exacta del archivo; si el overlay se desactiva por un fallo se restaura sola.
hybrid_value() {
  [ -f "$HYBRID_CONFIG" ] || { echo "sin-config"; return; }
  v=$(sed -n 's/^[[:space:]]*disable_umount[[:space:]]*=[[:space:]]*\([a-z]*\).*/\1/p' "$HYBRID_CONFIG" | head -n 1)
  echo "${v:-ausente}"
}

hybrid_apply() {
  [ -f "$HYBRID_CONFIG" ] || die "no hay $HYBRID_CONFIG: este móvil no usa hybrid_mount, el ajuste no aplica."
  if [ "$(hybrid_value)" = "true" ]; then
    say "hybrid_mount: disable_umount ya estaba en true; no se toca."
    return 0
  fi
  mkdir -p "$STATE_DIR"
  [ -f "$HYBRID_BACKUP" ] || cp "$HYBRID_CONFIG" "$HYBRID_BACKUP" || die "no se pudo guardar la copia de $HYBRID_CONFIG."
  tmp="$STATE_DIR/hybrid-config.new"
  if grep -qE '^[[:space:]]*disable_umount[[:space:]]*=' "$HYBRID_CONFIG"; then
    sed 's/^[[:space:]]*disable_umount[[:space:]]*=.*/disable_umount = true/' "$HYBRID_CONFIG" > "$tmp"
  else
    # Una clave suelta tiene que ir antes de la primera tabla ([...]); si no hay tablas, al final.
    n=$(grep -n '^\[' "$HYBRID_CONFIG" | head -n 1 | cut -d: -f1)
    if [ -n "$n" ]; then
      { head -n "$((n - 1))" "$HYBRID_CONFIG"; echo "disable_umount = true"; tail -n "+$n" "$HYBRID_CONFIG"; } > "$tmp"
    else
      # (si el archivo no acaba en salto de línea, se añade antes de la clave nueva)
      { cat "$HYBRID_CONFIG"; [ -n "$(tail -c 1 "$HYBRID_CONFIG")" ] && echo; echo "disable_umount = true"; } > "$tmp"
    fi
  fi
  # hybrid_mount rechaza el archivo entero si hay claves duplicadas o mal formadas: se comprueba antes de escribir.
  if [ "$(grep -cE '^[[:space:]]*disable_umount[[:space:]]*=' "$tmp")" != "1" ] || ! grep -qxE 'disable_umount = true' "$tmp"; then
    rm -f "$tmp"
    die "no se pudo preparar el cambio en $HYBRID_CONFIG (no se ha tocado nada)."
  fi
  # `cat >` conserva propietario, permisos y contexto SELinux del archivo.
  cat "$tmp" > "$HYBRID_CONFIG" || { rm -f "$tmp"; hybrid_restore quiet; die "no se pudo escribir $HYBRID_CONFIG."; }
  rm -f "$tmp"
  date '+%Y-%m-%d %H:%M:%S' > "$HYBRID_MARK"
  log "hybrid_mount: disable_umount = true (copia en $HYBRID_BACKUP)"
  hist hybrid "disable_umount = true (copia guardada)"
  say "hybrid_mount: disable_umount = true. Copia del original guardada; se restaura sola si el overlay falla."
}

hybrid_restore() {
  [ -f "$HYBRID_BACKUP" ] || { [ "$1" = "quiet" ] || say "hybrid_mount: no hay ajuste de Nexus que restaurar."; rm -f "$HYBRID_MARK"; return 0; }
  if cat "$HYBRID_BACKUP" > "$HYBRID_CONFIG"; then
    rm -f "$HYBRID_BACKUP" "$HYBRID_MARK"
    log "hybrid_mount: configuración original restaurada"
    hist hybrid "configuración original restaurada"
    [ "$1" = "quiet" ] || say "hybrid_mount: configuración original restaurada (surte efecto al reiniciar)."
  else
    log "hybrid_mount: NO se pudo restaurar $HYBRID_CONFIG (copia en $HYBRID_BACKUP)"
    [ "$1" = "quiet" ] || say "No se pudo restaurar. La copia original está en $HYBRID_BACKUP."
  fi
}

# --- Mantener la app al día con el módulo ---
# El módulo lleva dentro el APK de su misma versión (version y versionCode sincronizados). Con el
# módulo flasheado, la app instalada puede quedarse en una versión anterior (Android decide con qué
# copia arranca y a veces conserva la vieja). `sync-apk` instala el APK del módulo encima si la versión
# instalada es MENOR o Nexus no está instalado: es una actualización normal (conserva los datos), solo
# si la firma coincide. Nunca desinstala ni baja de versión. Lo llaman customize.sh (al flashear, si
# Android está en marcha) y service.sh (en cada arranque, con --wait).
bundled_apk() { echo "$MODDIR/system/product/priv-app/Nexus/Nexus.apk"; }
bundled_version_code() { sed -n 's/^versionCode=//p' "$MODDIR/module.prop" 2>/dev/null | head -n 1; }

do_sync_apk() {
  need_root
  apk=$(bundled_apk)
  want=$(bundled_version_code)
  [ -f "$apk" ] || die "el módulo no lleva el APK ($apk)."
  [ -n "$want" ] || die "no se pudo leer el versionCode del módulo."
  if [ "$1" = "--wait" ]; then
    # Tras el arranque, a la espera de que el sistema responda (hasta ~5 min) y un respiro para que se asiente.
    n=0
    while [ "$n" -lt 100 ]; do
      boot_completed && pm path android >/dev/null 2>&1 && break
      n=$((n + 1)); sleep 3
    done
    [ "$n" -ge 100 ] && { echo "el sistema no respondió a tiempo" > "$STATE_DIR/apk-sync" 2>/dev/null; return 0; }
    sleep "${NEXUS_SYNC_SETTLE:-20}"
  fi
  have=$(nexus_version_code)
  if [ -n "$have" ] && [ "$have" -ge "$want" ] 2>/dev/null; then
    say "Nexus ya está al día (instalado $have, módulo $want)."
    mkdir -p "$STATE_DIR"; echo "al día: instalado $have, módulo $want" > "$STATE_DIR/apk-sync"
    return 0
  fi
  say "Instalando el APK del módulo (instalado: ${have:-ninguno}, módulo: $want)…"
  tmp="${NEXUS_TMP_DIR:-/data/local/tmp}/nexus-module.apk"
  if ! cp "$apk" "$tmp" 2>/dev/null; then
    mkdir -p "$STATE_DIR"; echo "no se pudo copiar el APK a /data/local/tmp" > "$STATE_DIR/apk-sync"
    log "sync-apk: no se pudo copiar el APK"
    die "no se pudo copiar el APK a /data/local/tmp."
  fi
  chmod 0644 "$tmp" 2>/dev/null
  res=$(pm install -r "$tmp" 2>&1)
  rm -f "$tmp"
  mkdir -p "$STATE_DIR"
  case "$res" in
    *Success*)
      echo "actualizado de ${have:-nada} a $want" > "$STATE_DIR/apk-sync"
      log "sync-apk: instalado el APK del módulo ($want) sobre ${have:-nada}"
      hist apk "actualizado de ${have:-nada} a $want"
      say "Nexus actualizado a la versión del módulo ($want)."
      ;;
    *)
      echo "falló: $(echo "$res" | tr '\n' ' ' | cut -c1-200)" > "$STATE_DIR/apk-sync"
      log "sync-apk: pm install falló: $res"
      hist apk "no se pudo actualizar: $(echo "$res" | tr '\n' ' ' | cut -c1-120)"
      say "No se pudo instalar el APK del módulo: $res"
      case "$res" in
        *INCOMPATIBLE* | *signature*) say "La app instalada está firmada con otra clave. Desinstálala a mano (perderías sus datos) o instala el APK de la release encima." ;;
      esac
      return 1
      ;;
  esac
}

# --- Historial de intentos ---
# Una línea por suceso en history.log, que el WebUI muestra como cronología. Durante el arranque temprano
# (post-fs-data) el reloj aún no está ajustado y la fecha sale 1970: el WebUI lo trata como "al arrancar".
hist() {
  mkdir -p "$STATE_DIR" 2>/dev/null
  # El detalle va en una línea y sin "|" (separador).
  d=$(printf '%s' "$2" | tr '\n|' '  ')
  echo "$(date '+%Y-%m-%d %H:%M:%S')|$1|$d" >> "$HISTORY_FILE" 2>/dev/null
  if [ "$(wc -l < "$HISTORY_FILE" 2>/dev/null || echo 0)" -gt 120 ]; then
    tail -n 80 "$HISTORY_FILE" > "$HISTORY_FILE.tmp" 2>/dev/null && cat "$HISTORY_FILE.tmp" > "$HISTORY_FILE"
    rm -f "$HISTORY_FILE.tmp"
  fi
}

do_history() {
  [ -r "$HISTORY_FILE" ] && cat "$HISTORY_FILE"
  return 0
}

# Por qué se desactivó el overlay, en una palabra (para que el WebUI explique y recomiende).
tripped_kind() {
  t=$(cat "$STATE_DIR/tripped" 2>/dev/null)
  [ -n "$t" ] || { echo ""; return; }
  case "$t" in
    *"zygote no puede abrir"*) echo "zygote-overlay" ;;
    *"no terminó"*) echo "boot-incomplete" ;;
    *"no se enlazó"* | *"se perdió el enlace"*) echo "not-bound" ;;
    *) echo "other" ;;
  esac
}

# Nexus como app de sistema privilegiada: NX_SYSTEM y NX_PRIV valen 1, 0 o ? (si `dumpsys package` no
# trae la línea; el formato no está verificado en todas las ROM).
nexus_flags() {
  pk=$(dumpsys package "$PKG" 2>/dev/null)
  NX_PRIV="?"; NX_SYSTEM="?"
  if echo "$pk" | grep -q 'privateFlags='; then
    if echo "$pk" | grep 'privateFlags=' | head -n 1 | grep -q 'PRIVILEGED'; then NX_PRIV=1; else NX_PRIV=0; fi
  fi
  if echo "$pk" | grep -q 'pkgFlags='; then
    if echo "$pk" | grep 'pkgFlags=' | head -n 1 | grep -q ' SYSTEM'; then NX_SYSTEM=1; else NX_SYSTEM=0; fi
  fi
}

# Ids de los módulos de root activos (sin disable ni remove).
active_module_ids() {
  for d in "$MODULES_DIR"/*/; do
    [ -f "${d}module.prop" ] || continue
    [ -f "${d}disable" ] && continue
    [ -f "${d}remove" ] && continue
    sed -n 's/^id=//p' "${d}module.prop" | head -n 1
  done
}

# --- Comprobaciones previas ---
# Salida: líneas `check|id|nivel|título|detalle` (nivel: ok, warn, bad o info) y una línea
# `recommend|camino|explicación`. Solo lee: no cambia nada. La lee el WebUI (pestaña Comprobaciones).
pf() { echo "check|$1|$2|$3|$(printf '%s' "$4" | tr '\n|' '  ')"; }

do_preflight() {
  need_root
  ids=$(active_module_ids)
  # Gestor de root (orientativo).
  if [ -d /data/adb/ksu ] || command -v ksud >/dev/null 2>&1; then root_mgr="KernelSU"
  elif [ -d /data/adb/ap ]; then root_mgr="APatch"
  elif [ -d /data/adb/magisk ]; then root_mgr="Magisk"
  else root_mgr="desconocido"; fi
  zy=$(echo "$ids" | grep -i 'zygisk' | tr '\n' ' ')
  has_hybrid=0
  { [ -f "$HYBRID_CONFIG" ] || echo "$ids" | grep -qi 'hybrid'; } && has_hybrid=1
  stack="$root_mgr"
  [ "$has_hybrid" = "1" ] && stack="$stack, hybrid_mount"
  [ -n "$zy" ] && stack="$stack, ${zy% }"
  pf stack info "Root detectado" "$stack"

  if [ -f "$MODDIR/disable" ]; then
    pf module bad "Módulo desactivado en el gestor" "Actívalo en el gestor de root y reinicia."
  else
    pf module ok "Módulo activo" "versión $(sed -n 's/^version=//p' "$MODDIR/module.prop" 2>/dev/null | head -n 1)"
  fi

  if [ -f "$PRODUCT_DIR/priv-app/Nexus/Nexus.apk" ]; then
    nexus_flags
    case "$NX_PRIV" in
      1) pf nexus ok "Nexus es app privilegiada de /product" "El módulo la montó y Android la registró como app de sistema." ;;
      0) pf nexus bad "Nexus está montado pero no es privilegiada" "Reinicia una vez tras flashear. Si sigue igual, revisa el metamódulo de montaje." ;;
      *) pf nexus warn "Nexus está montado" "No se pudo leer si es privilegiada (dumpsys package sin esa línea)." ;;
    esac
  else
    pf nexus bad "Nexus no está montado en /product" "Reinicia tras flashear. En KernelSU hace falta un metamódulo de montaje (hybrid_mount, meta-overlayfs…): sin él no se monta nada."
  fi

  if [ -f "$MODDIR/overlay-static/NexusRecentsOverlay.apk" ]; then
    pf overlayapk ok "El módulo lleva el overlay" "overlay-static/NexusRecentsOverlay.apk"
  else
    pf overlayapk bad "Falta el overlay en el módulo" "Reflashea el módulo."
  fi

  want=$(bundled_version_code); have=$(nexus_version_code)
  if [ -z "$have" ]; then
    pf apk warn "Nexus no está instalado" "El módulo lleva la versión $want. Se instala solo en el próximo arranque, o desde Ajustes."
  elif [ -n "$want" ] && [ "$have" -lt "$want" ] 2>/dev/null; then
    pf apk warn "La app es más antigua que la del módulo" "Instalada $have, módulo $want. $(cat "$STATE_DIR/apk-sync" 2>/dev/null)"
  else
    pf apk ok "La app está al día con el módulo" "instalada $have, módulo ${want:-?}"
  fi

  if [ -r "$PROBE_FILE" ]; then
    if [ "$(probe_value passed)" = "true" ]; then
      pf compat ok "Quickstep es compatible con este Android" "sdk $(probe_value sdk)"
    else
      pf compat warn "Quickstep puede no ser compatible" "sdk $(probe_value sdk); falta: $(probe_value missing). Con «Forzar» se activa igualmente."
    fi
  else
    pf compat warn "Nexus aún no comprobó la compatibilidad" "Abre Nexus una vez y vuelve aquí (o usa «Forzar»)."
  fi

  if [ -e "$PRODUCT_DIR/overlay/config/config.xml" ]; then
    pf oemconfig bad "Hay un overlay/config/config.xml en /product" "El sistema ignoraría un overlay estático que no esté en él."
  else
    pf oemconfig ok "Sin overlay/config/config.xml" "Un overlay estático nuevo no será ignorado."
  fi

  if [ "$has_hybrid" = "1" ]; then
    hv=$(hybrid_value)
    if [ "$hv" = "true" ]; then
      pf hybrid ok "hybrid_mount: disable_umount = true" "Las apps ven los montajes del módulo$([ -f "$HYBRID_MARK" ] && echo " (cambiado por Nexus)")."
    elif [ -n "$zy" ]; then
      pf hybrid warn "hybrid_mount + Zygisk: riesgo de fallo con el overlay" "Con esta combinación zygote perdió el montaje del overlay en un arranque anterior. El Plan A ajusta disable_umount."
    else
      pf hybrid info "hybrid_mount detectado" "disable_umount = $hv"
    fi
  fi

  kind=$(tripped_kind)
  pa_failed=0; [ -f "$STATE_DIR/plan-a-failed" ] && pa_failed=1
  [ "$pa_failed" = "1" ] && pf plana bad "El Plan A ya se probó y no bastó" "Con disable_umount = true el arranque con el overlay también falló. La configuración de hybrid_mount se restauró sola."
  if [ -n "$kind" ]; then
    case "$kind" in
      zygote-overlay) pf previous bad "El último intento rompió el arranque" "Zygote no pudo abrir el APK del overlay y todas las apps abortaron. El módulo reinició solo." ;;
      boot-incomplete) pf previous bad "El último arranque con overlay no terminó" "$(cat "$STATE_DIR/tripped")" ;;
      not-bound) pf previous warn "Se desactivó: SystemUI no se enlazó" "$(cat "$STATE_DIR/tripped")" ;;
      *) pf previous warn "El vigilante desactivó el overlay" "$(cat "$STATE_DIR/tripped")" ;;
    esac
  fi

  rc=$(current_recents)
  rpkg=${rc%%/*}
  if [ -n "$rpkg" ] && [ "$rpkg" != "$PKG" ]; then
    pf rom info "Recientes de la ROM" "$rpkg (el Plan B pondría a Nexus con ese mismo paquete; aún no disponible en esta versión)"
  elif [ "$rpkg" = "$PKG" ]; then
    pf rom ok "Nexus ya es el proveedor de recientes" "$rc"
  fi

  # Recomendación: lo primero que no esté bien manda.
  if [ -f "$MODDIR/disable" ] || [ ! -f "$PRODUCT_DIR/priv-app/Nexus/Nexus.apk" ]; then
    echo "recommend|install|Primero hay que dejar el módulo montado: actívalo, reinicia y vuelve aquí."
  elif overlay_effective && is_bound; then
    echo "recommend|active|Todo en marcha: Nexus es el proveedor de recientes y SystemUI está enlazado."
  elif [ "$pa_failed" = "1" ] || { [ "$kind" = "zygote-overlay" ] && { [ "$has_hybrid" != "1" ] || [ "$(hybrid_value)" = "true" ]; }; }; then
    echo "recommend|plan-b|El overlay no sirve en este móvil ni con el ajuste de hybrid_mount: el siguiente camino es el Plan B (Nexus con el paquete del launcher de la ROM)."
  elif [ "$kind" = "zygote-overlay" ]; then
    echo "recommend|plan-a|El fallo fue el de zygote con hybrid_mount: prueba el Plan A (ajuste disable_umount). Se restaura solo si falla."
  elif [ "$has_hybrid" = "1" ] && [ -n "$zy" ] && [ "$(hybrid_value)" != "true" ]; then
    echo "recommend|plan-a|Tu pila de root (hybrid_mount + Zygisk) ya dio este fallo: empieza por el Plan A."
  else
    echo "recommend|enable|Puedes activar los gestos. Si el arranque falla, el módulo vuelve solo al estado de serie."
  fi
}

do_umount_fix() {
  need_root
  case "$1" in
    on) hybrid_apply; say "Reinicia para que hybrid_mount lo lea." ;;
    restore) hybrid_restore ;;
    status | "")
      say "hybrid_mount config: $([ -f "$HYBRID_CONFIG" ] && echo "$HYBRID_CONFIG" || echo "no encontrada")"
      say "disable_umount: $(hybrid_value)"
      [ -f "$HYBRID_MARK" ] && say "Cambiado por Nexus el $(cat "$HYBRID_MARK") (copia original en $HYBRID_BACKUP)"
      ;;
    *) usage 2 ;;
  esac
}

do_enable() {
  force=0
  umount_fix=0
  for arg in "$@"; do
    case "$arg" in
      --force) force=1 ;;
      --umount-fix) umount_fix=1 ;;
    esac
  done
  need_root
  [ "$umount_fix" = "1" ] && [ ! -f "$HYBRID_CONFIG" ] && die "no hay $HYBRID_CONFIG: este móvil no usa hybrid_mount, --umount-fix no aplica."
  [ -f "$MODDIR/overlay-static/NexusRecentsOverlay.apk" ] || die "el módulo no lleva el overlay: reflashea el módulo y reinicia."
  [ -f "$MODDIR/disable" ] && die "el módulo está desactivado en el gestor (archivo disable)."
  # Con un overlay/config/config.xml en /product los overlays estáticos de esa partición que no
  # aparezcan en él se ignoran, y los que sí se ignoran dejan de aplicarse: no se toca.
  if [ -e "$PRODUCT_DIR/overlay/config/config.xml" ] && [ "$force" != "1" ]; then
    die "/product/overlay/config/config.xml existe: el sistema ignoraría un overlay estático que no esté en él. Con --force se prueba igualmente."
  fi
  version=$(nexus_version_code)
  if [ "$force" != "1" ]; then
    [ -r "$PROBE_FILE" ] || die "Nexus aún no ha comprobado la compatibilidad: ábrelo una vez (o usa --force)."
    passed=$(probe_value passed)
    if [ "$passed" != "true" ]; then
      missing=$(probe_value missing)
      die "Quickstep no es compatible con este Android (sdk=$(probe_value sdk); falta: ${missing:-?}). Con --force se activa igualmente, pero los gestos pueden dejar de funcionar."
    fi
    tripped_version=$(sed -n 's/^version=//p' "$STATE_DIR/tripped.meta" 2>/dev/null)
    if [ -r "$STATE_DIR/tripped" ] && { [ -z "$tripped_version" ] || [ -z "$version" ] || [ "$tripped_version" = "$version" ] || [ "$tripped_version" = "bootloop" ]; }; then
      die "el overlay se desactivó solo ($(cat "$STATE_DIR/tripped")). Tras un fallo de arranque o con esta versión de Nexus ($version) hace falta --force; si es solo la versión, actualizar Nexus también vale."
    fi
  fi
  mkdir -p "$STATE_DIR"
  [ "$umount_fix" = "1" ] && hybrid_apply
  rm -f "$STATE_DIR/tripped" "$STATE_DIR/tripped.meta" "$STATE_DIR/healthy" "$STATE_DIR/booting"
  echo "$(date '+%Y-%m-%d %H:%M:%S') version=$version" > "$STATE_DIR/enabled"
  hist pedido "overlay pedido$([ "$force" = "1" ] && echo ", forzado")$([ "$umount_fix" = "1" ] && echo ", con ajuste de hybrid_mount")"
  say "Overlay pedido. REINICIA para que el sistema lo aplique en el arranque."
  say "Tras reiniciar: nexus-quickstep status  y  nexus-quickstep bound"
  say "Si SystemUI no llega a enlazarse con Nexus, el vigilante lo desactiva y reinicia solo."
  say "Para deshacerlo: nexus-quickstep disable --reboot"
}

do_disable() {
  need_root
  rm -f "$STATE_DIR/enabled" "$STATE_DIR/booting" "$STATE_DIR/healthy"
  hist desactivado "desactivado a mano"
  # Se borra también la copia ya montada (por si el módulo no se reinicia limpio).
  rm -f "$MODDIR/system/product/overlay/NexusRecentsOverlay.apk" 2>/dev/null
  if [ "$1" = "--reboot" ]; then
    say "Overlay desactivado. Reiniciando: el gesto vuelve al launcher del sistema."
    reboot
  else
    say "Overlay desactivado para el próximo arranque. Reinicia para que los gestos vuelvan al launcher del sistema."
    say "(El overlay es estático: mientras no reinicies, Nexus sigue siendo el proveedor de recientes.)"
  fi
}

do_bound() {
  lines=$(bound_lines)
  if [ -n "$lines" ]; then
    say "SystemUI enlazado al servicio de Quickstep de Nexus: sí"
    say "$lines"
    exit 0
  fi
  say "SystemUI enlazado al servicio de Quickstep de Nexus: NO"
  say "(overlay efectivo: $(overlay_effective && echo sí || echo no); estado: $(overlay_state))"
  exit 1
}

# Quickstep de Nexus no funciona: se quita el archivo `enabled`, se deja constancia y se reinicia
# para que el siguiente arranque vaya sin overlay. No hay más reinicios: sin `enabled` el módulo
# no vuelve a aplicarlo, así que no puede haber un bucle.
trip() {
  reason="$1"
  log "DESACTIVO el overlay: $reason"
  hist desactivado-auto "$reason"
  mkdir -p "$STATE_DIR"
  echo "$(date '+%Y-%m-%d %H:%M:%S') $reason" > "$STATE_DIR/tripped"
  echo "version=$(nexus_version_code)" > "$STATE_DIR/tripped.meta"
  rm -f "$STATE_DIR/enabled" "$STATE_DIR/booting" "$STATE_DIR/healthy"
  # Si el overlay se probó con el ajuste de hybrid_mount, se anota que el Plan A no bastó antes de restaurarlo.
  [ -f "$HYBRID_MARK" ] && touch "$STATE_DIR/plan-a-failed"
  hybrid_restore quiet
  capture_stop
  logs_sync
  if [ "${NEXUS_GUARD_NO_REBOOT:-0}" = "1" ]; then
    log "reinicio omitido (NEXUS_GUARD_NO_REBOOT=1)"
  else
    log "reiniciando para arrancar sin overlay"
    sleep 2
    reboot
  fi
}

do_guard() {
  if [ ! -f "$STATE_DIR/enabled" ]; then
    rm -f "$STATE_DIR/booting"
    capture_stop
    log "arranque: overlay no pedido, nada que vigilar"
    # Aunque no haya overlay, se deja en Nexus-Logs el registro de un arranque fallido anterior.
    logs_sync_later
    exit 0
  fi
  log "arranque con el overlay pedido: vigilando (espera ${GUARD_WAIT}s, vigilancia ${GUARD_WATCH}s)"

  waited=0
  while ! boot_completed; do
    sleep "$GUARD_STEP"
    waited=$((waited + GUARD_STEP))
    [ "$waited" -ge 600 ] && { trip "el arranque no terminó en 600 s"; exit 0; }
  done

  # ¿Entró el overlay? Si otro overlay de la imagen gana, o no se aplicó, no hay nada que verificar:
  # no es un fallo de Quickstep y no se reinicia.
  if ! overlay_effective; then
    log "overlay pedido pero no efectivo ($(current_recents)): no se vigila"
    rm -f "$STATE_DIR/booting"
    capture_stop
    logs_sync_later
    exit 0
  fi

  # Primer enlace: SystemUI tarda en arrancar y en enlazar; se da un margen.
  waited=0
  while ! is_bound; do
    [ "$waited" -ge "$GUARD_WAIT" ] && { trip "SystemUI no se enlazó al servicio de Nexus en ${GUARD_WAIT} s"; exit 0; }
    sleep "$GUARD_STEP"
    waited=$((waited + GUARD_STEP))
  done
  log "SystemUI enlazado al servicio de Nexus tras ${waited}s"
  mkdir -p "$STATE_DIR"
  date '+%Y-%m-%d %H:%M:%S' > "$STATE_DIR/healthy"
  if [ -f "$HYBRID_MARK" ]; then
    rm -f "$STATE_DIR/plan-a-failed"
    hist verificado "arrancó con el overlay y SystemUI se enlazó a Nexus (con el Plan A)"
  else
    hist verificado "arrancó con el overlay y SystemUI se enlazó a Nexus"
  fi
  rm -f "$STATE_DIR/booting"
  capture_stop
  logs_sync_later

  # Vigilancia: si el servicio se cae justo después de arrancar y no vuelve, se desactiva.
  watched=0
  lost=0
  while [ "$watched" -lt "$GUARD_WATCH" ]; do
    sleep "$GUARD_STEP"
    watched=$((watched + GUARD_STEP))
    if is_bound; then
      lost=0
    else
      lost=$((lost + GUARD_STEP))
      [ "$lost" -ge "$GUARD_LOST" ] && { trip "se perdió el enlace con el servicio de Nexus durante ${GUARD_LOST} s"; exit 0; }
    fi
  done
  log "vigilancia terminada: enlace estable"
}

boot_id() {
  cat /proc/sys/kernel/random/boot_id 2>/dev/null
}

sdcard_ready() {
  [ -d "$SDCARD_READY" ]
}

# Resumen en lenguaje llano de cómo va (o cómo fue) el arranque con el overlay.
write_resumen() {
  {
    echo "NEXUS QUICKSTEP: RESUMEN DEL ARRANQUE"
    echo "Actualizado: $(date '+%Y-%m-%d %H:%M:%S')"
    echo
    if [ -f "$FAILED_DIR/saved-at" ]; then
      echo "ARRANQUE ANTERIOR: FALLÓ (el sistema no terminó de arrancar con el overlay)."
      echo "  Registro guardado: $(cat "$FAILED_DIR/saved-at"). Está en la carpeta arranque-fallido/."
      [ -r "$FAILED_DIR/abort-reason" ] && echo "  Causa detectada: $(cat "$FAILED_DIR/abort-reason")"
    else
      echo "ARRANQUE ANTERIOR: sin fallos registrados."
    fi
    echo
    if [ -f "$STATE_DIR/enabled" ]; then
      echo "Overlay pedido: sí"
    else
      echo "Overlay pedido: no (arranque normal, sin overlay)"
    fi
    if boot_completed; then
      echo "Este arranque: el sistema TERMINÓ de arrancar."
    else
      echo "Este arranque: el sistema todavía NO ha terminado de arrancar."
    fi
    if overlay_effective; then
      echo "Overlay efectivo: sí"
      if is_bound; then echo "SystemUI enlazado a Nexus: sí"; else echo "SystemUI enlazado a Nexus: no (todavía)"; fi
    else
      echo "Overlay efectivo: no"
    fi
    if [ -e "$STATE_DIR/healthy" ]; then
      echo
      echo "RESULTADO: OK. Arrancó con el overlay y SystemUI se enlazó a Nexus."
    elif [ -r "$STATE_DIR/tripped" ]; then
      echo
      echo "RESULTADO: DESACTIVADO por seguridad: $(cat "$STATE_DIR/tripped")"
    fi
    echo
    echo "Archivos de esta carpeta:"
    echo "  arranque-actual/    logcat y dmesg de este arranque"
    echo "  arranque-fallido/   logcat, dmesg y pstore del último arranque que no terminó"
    echo "  watchdog.log        decisiones del módulo"
  } > "$LOGS_DIR/RESUMEN.txt" 2>/dev/null
}

# Copia todos los registros a LOGS_DIR. No falla si el almacenamiento no está disponible.
logs_sync() {
  sdcard_ready || return 1
  mkdir -p "$LOGS_DIR" 2>/dev/null || return 1
  mkdir -p "$LOGS_DIR/arranque-actual" 2>/dev/null
  write_resumen
  # Solo el registro de ESTE arranque; si no lo hay (arranque sin overlay) no se deja uno viejo aquí.
  if [ -r "$CAPTURE_DIR/boot_id" ] && [ "$(cat "$CAPTURE_DIR/boot_id")" = "$(boot_id)" ]; then
    cp "$CAPTURE_DIR"/logcat.log* "$CAPTURE_DIR/dmesg.log" "$CAPTURE_DIR/started" "$LOGS_DIR/arranque-actual"/ 2>/dev/null
  else
    rm -rf "$LOGS_DIR/arranque-actual"
    echo "Este arranque no registró logcat (se registra solo cuando el overlay está pedido)." > "$LOGS_DIR/arranque-actual.txt"
  fi
  cp "$STATE_DIR/watchdog.log" "$LOGS_DIR/" 2>/dev/null
  if [ -d "$FAILED_DIR" ]; then
    mkdir -p "$LOGS_DIR/arranque-fallido" 2>/dev/null
    cp -r "$FAILED_DIR"/. "$LOGS_DIR/arranque-fallido"/ 2>/dev/null
  fi
  chmod -R a+rwX "$LOGS_DIR" 2>/dev/null
  return 0
}

# Espera hasta $1 segundos a que el almacenamiento esté disponible (0 = no espera).
logs_wait() {
  waited=0
  while ! sdcard_ready; do
    [ "$waited" -ge "${1:-0}" ] && return 1
    sleep 5; waited=$((waited + 5))
  done
  return 0
}

# Lo usa el vigilante: en segundo plano, para no retrasar la vigilancia ni morir si no hay almacenamiento.
logs_sync_later() {
  ( logs_wait 900 && logs_sync ) </dev/null >/dev/null 2>&1 &
}

do_logs() {
  need_root
  logs_wait "${1:-0}" || die "el almacenamiento interno no está disponible (¿móvil sin desbloquear?)."
  logs_sync
  say "Registros copiados a $LOGS_DIR"
}

# Arranca, en segundo plano y sin bloquear a quien lo llama (post-fs-data.sh), el registro del
# arranque y un temporizador: si sys.boot_completed no llega en BOOT_TIMEOUT s el sistema se
# reinicia solo. El marcador `booting` sigue puesto, así que el arranque siguiente va sin overlay
# (post-fs-data.sh) y conserva este registro en failed-boot/.
capture_start() {
  mkdir -p "$CAPTURE_DIR" 2>/dev/null || return 0
  rm -f "$CAPTURE_DIR"/* 2>/dev/null
  boot_id > "$CAPTURE_DIR/boot_id"
  date '+%Y-%m-%d %H:%M:%S' > "$CAPTURE_DIR/started"
  logcat -b all -v threadtime -f "$CAPTURE_DIR/logcat.log" -r 4096 -n 4 </dev/null >/dev/null 2>&1 &
  echo $! > "$CAPTURE_DIR/logcat.pid"
  dmesg -w </dev/null > "$CAPTURE_DIR/dmesg.log" 2>/dev/null &
  echo $! > "$CAPTURE_DIR/dmesg.pid"
  (
    waited=0
    while [ "$waited" -lt "$BOOT_TIMEOUT" ]; do
      [ "$(getprop sys.boot_completed)" = "1" ] && exit 0
      # Firma del fallo visto en un móvil real: zygote no puede reabrir el APK del overlay en cada
      # proceso nuevo (el archivo del módulo no se ve desde ahí) y TODAS las apps abortan, SystemUI
      # incluida: el arranque nunca termina. No hace falta esperar a BOOT_TIMEOUT.
      if grep -q -a "Failed open($OVERLAY_PATH" "$CAPTURE_DIR/logcat.log" 2>/dev/null; then
        echo "zygote no puede abrir $OVERLAY_PATH: todas las apps abortan" > "$STATE_DIR/abort-reason"
        log "DETECTADO: zygote no puede abrir $OVERLAY_PATH; reinicio sin overlay"
        capture_probe
        sleep 3
        capture_stop_logcat
        sync
        setprop sys.powerctl reboot,nexus_overlay_unreadable 2>/dev/null || reboot
        exit 0
      fi
      sleep 5
      waited=$((waited + 5))
    done
    log "el arranque no terminó en ${BOOT_TIMEOUT} s: reinicio automático"
    sync
    setprop sys.powerctl reboot,nexus_boot_timeout 2>/dev/null || reboot
  ) </dev/null >/dev/null 2>&1 &
  echo $! > "$CAPTURE_DIR/timer.pid"
  # Copia periódica a la carpeta Nexus-Logs en cuanto el almacenamiento esté disponible.
  (
    while ! sdcard_ready; do sleep 5; done
    while :; do
      logs_sync
      sleep 10
    done
  ) </dev/null >/dev/null 2>&1 &
  echo $! > "$CAPTURE_DIR/sync.pid"
}

# Qué ve cada proceso importante del overlay y de /product. Se ejecuta justo al detectar el fallo de
# zygote (antes de reiniciar), que es el único momento en que esa información existe: el arranque
# siguiente va sin overlay. /proc/<pid>/root resuelve rutas en el espacio de montajes de ese proceso.
capture_probe() {
  out="$CAPTURE_DIR/probe.txt"
  {
    echo "Sonda de visibilidad del overlay: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "archivo esperado: $OVERLAY_PATH"
    echo
    echo "--- init (1)"
    ls -l "/proc/1/root$OVERLAY_PATH" 2>&1
    echo "--- montajes de /product en init"
    grep -E ' /product( |/)' /proc/1/mountinfo 2>&1 | head -n 10
    for name in zygote64 zygote system_server; do
      for pid in $(pidof "$name" 2>/dev/null); do
        echo
        echo "--- $name ($pid)  ns: $(readlink /proc/$pid/ns/mnt 2>&1)  uid: $(awk '/^Uid:/{print $2}' /proc/$pid/status 2>/dev/null)"
        echo "archivo visible: $(ls -l /proc/$pid/root$OVERLAY_PATH 2>&1)"
        echo "directorio /product/overlay: $(ls /proc/$pid/root/product/overlay 2>&1 | tr '\n' ' ' | cut -c1-300)"
        echo "montajes de /product:"
        grep -E ' /product( |/)' /proc/$pid/mountinfo 2>&1 | head -n 10
        echo "fds abiertos que mencionan el overlay:"
        ls -l /proc/$pid/fd 2>/dev/null | grep -i -E 'NexusRecents|product/overlay' | head -n 10
      done
    done
    echo
    echo "--- ns de montajes distintos entre init y zygote64:"
    zp=$(pidof zygote64 2>/dev/null | awk '{print $1}')
    echo "init=$(readlink /proc/1/ns/mnt) zygote64=$(readlink /proc/$zp/ns/mnt 2>/dev/null)"
    echo
    echo "--- configuración de hybrid_mount"
    cat /data/adb/hybrid-mount/config.toml 2>&1 | head -n 40
    echo
    echo "--- zygisk (módulos en /data/adb)"
    ls /data/adb/neozygisk /data/adb/modules 2>&1 | head -n 40
  } > "$out" 2>&1
  return 0
}

# Para solo los procesos de registro (lo usa el temporizador, que no debe matarse a sí mismo).
capture_stop_logcat() {
  for name in logcat dmesg; do
    pid=$(cat "$CAPTURE_DIR/$name.pid" 2>/dev/null)
    [ -n "$pid" ] && kill "$pid" 2>/dev/null
  done
  return 0
}

# Para el registro y el temporizador. Solo toca los procesos de ESTE arranque (los pid de un
# arranque anterior podrían ser de otro proceso).
capture_stop() {
  [ -r "$CAPTURE_DIR/boot_id" ] && [ "$(cat "$CAPTURE_DIR/boot_id")" = "$(boot_id)" ] || return 0
  for name in logcat dmesg timer sync; do
    pid=$(cat "$CAPTURE_DIR/$name.pid" 2>/dev/null)
    [ -n "$pid" ] && kill "$pid" 2>/dev/null
    rm -f "$CAPTURE_DIR/$name.pid"
  done
  return 0
}

# Guarda el registro del arranque que no terminó (más el de pstore, si el kernel lo conserva).
capture_keep() {
  rm -rf "$FAILED_DIR"
  mkdir -p "$FAILED_DIR" 2>/dev/null || return 0
  cp "$CAPTURE_DIR"/logcat.log* "$CAPTURE_DIR/dmesg.log" "$CAPTURE_DIR/started" "$CAPTURE_DIR/probe.txt" "$FAILED_DIR"/ 2>/dev/null
  if ls /sys/fs/pstore/* >/dev/null 2>&1; then
    mkdir -p "$FAILED_DIR/pstore"
    cp /sys/fs/pstore/* "$FAILED_DIR/pstore"/ 2>/dev/null
  fi
  [ -f "$STATE_DIR/abort-reason" ] && cp "$STATE_DIR/abort-reason" "$FAILED_DIR/" 2>/dev/null
  date '+%Y-%m-%d %H:%M:%S' > "$FAILED_DIR/saved-at"
  return 0
}

# --- Nexus como app de Inicio (rol HOME) ---
# `home-role on` pone a Nexus como app de Inicio con `cmd role add-role-holder`; `home-role off` devuelve el
# launcher que había antes. NUNCA se ejecuta solo (ni en el arranque ni en el vigilante): solo a petición.
#
# HIPÓTESIS SIN VERIFICAR EN ANDROID 17: la sintaxis de `cmd role` (subcomandos get-role-holders,
# add-role-holder y remove-role-holder, y el indicador --user) está tomada de lo que se sabe de AOSP, no
# comprobada en esta ROM. Por eso, antes de tocar nada, se lee `cmd role help` y se exige que lista esos
# subcomandos; el --user solo se usa si la ayuda lo menciona. Si no cuadra, se niega y no cambia nada.
# El formato de `dumpsys role` (name=android.app.role.HOME / holders=<paquete>) sí está visto en móviles
# reales, y se usa para leer el titular actual si get-role-holders no devuelve nada.
#
# Cambiar de app de Inicio no afecta al arranque; a mano se deshace en Ajustes > Apps > Apps
# predeterminadas > App de inicio.
HOME_ROLE="android.app.role.HOME"
HOME_PREV="$STATE_DIR/home-role-prev"

# Comprueba que `cmd role` sirve y fija RUSER. Devuelve 0 si se puede usar, 1 si no (y deja el motivo en ROLE_WHY).
role_probe() {
  ROLE_WHY=""
  RUSER=""
  rh=$(tmo 10 cmd role help 2>&1)
  for sub in get-role-holders add-role-holder remove-role-holder; do
    case "$rh" in
      *"$sub"*) ;;
      *) ROLE_WHY="este Android no tiene «cmd role $sub» (salida de «cmd role help»: $(echo "$rh" | head -n 2 | tr '\n' ' ' | cut -c1-120))"; return 1 ;;
    esac
  done
  case "$rh" in *--user*) RUSER="--user $USER_ID" ;; esac
  return 0
}

# Titular actual del rol de Inicio (vacío si no se puede leer).
home_holder() {
  # shellcheck disable=SC2086
  h=$(tmo 10 cmd role get-role-holders $RUSER "$HOME_ROLE" 2>/dev/null | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -v '^$' | head -n 1)
  if [ -z "$h" ]; then
    h=$(tmo 10 dumpsys role 2>/dev/null | grep -A3 "name=$HOME_ROLE" | sed -n 's/.*holders=//p' | head -n 1 | sed 's/[, ].*//')
  fi
  echo "$h"
}

pkg_installed() {
  tmo 10 pm path "$1" 2>/dev/null | grep -q '^package:'
}

do_home_role() {
  need_root
  case "$1" in
    status)
      if role_probe; then
        cur=$(home_holder)
        kv role_cmd 1
        kv holder "$cur"
        kv nexus_is_home "$([ "$cur" = "$PKG" ] && echo 1 || echo 0)"
      else
        kv role_cmd 0
        kv role_why "$ROLE_WHY"
        kv holder ""
        kv nexus_is_home 0
      fi
      kv nexus_installed "$(pkg_installed "$PKG" && echo 1 || echo 0)"
      kv prev "$(head -n 1 "$HOME_PREV" 2>/dev/null)"
      ;;
    on)
      role_probe || die "no se cambia nada: $ROLE_WHY."
      pkg_installed "$PKG" || die "Nexus ($PKG) no está instalado: no se cambia nada."
      cur=$(home_holder)
      if [ "$cur" = "$PKG" ]; then
        say "Nexus ya es la app de Inicio. No se cambia nada."
        return 0
      fi
      mkdir -p "$STATE_DIR" 2>/dev/null
      wrote_prev=0
      if [ -n "$cur" ]; then
        echo "$cur" > "$HOME_PREV" && wrote_prev=1
      fi
      say "App de Inicio actual: ${cur:-desconocida}. Poniendo a Nexus…"
      # shellcheck disable=SC2086
      res=$(tmo 20 cmd role add-role-holder $RUSER "$HOME_ROLE" "$PKG" 2>&1)
      log "home-role on: add-role-holder -> $(echo "$res" | tr '\n' ' ' | cut -c1-160)"
      now=$(home_holder)
      if [ "$now" = "$PKG" ]; then
        hist home "Nexus puesto como app de Inicio (antes: ${cur:-desconocida})"
        say "Hecho: Nexus es ahora la app de Inicio. Para volver: nexus-quickstep home-role off."
      else
        [ "$wrote_prev" = "1" ] && rm -f "$HOME_PREV"
        hist home "no se pudo poner a Nexus como app de Inicio: $(echo "$res" | tr '\n' ' ' | cut -c1-100)"
        die "no se pudo: tras add-role-holder el titular es «${now:-desconocido}». Respuesta del sistema: ${res:-(vacía)}. Nada más se ha tocado."
      fi
      ;;
    off)
      role_probe || die "no se cambia nada: $ROLE_WHY."
      cur=$(home_holder)
      if [ "$cur" != "$PKG" ]; then
        say "Nexus no es la app de Inicio ahora (lo es: ${cur:-desconocida}). No se cambia nada."
        return 0
      fi
      prev=$(head -n 1 "$HOME_PREV" 2>/dev/null)
      [ -n "$prev" ] || die "no hay guardado cuál era el launcher anterior (¿lo cambiaste a mano?). No se cambia nada: elige otro en Ajustes > Apps > Apps predeterminadas > App de inicio."
      pkg_installed "$prev" || die "el launcher anterior ($prev) ya no está instalado. No se cambia nada: elige otro en Ajustes > Apps > Apps predeterminadas > App de inicio."
      say "Devolviendo la app de Inicio a $prev…"
      # shellcheck disable=SC2086
      res=$(tmo 20 cmd role add-role-holder $RUSER "$HOME_ROLE" "$prev" 2>&1)
      log "home-role off: add-role-holder $prev -> $(echo "$res" | tr '\n' ' ' | cut -c1-160)"
      now=$(home_holder)
      if [ "$now" = "$prev" ]; then
        rm -f "$HOME_PREV"
        hist home "app de Inicio devuelta a $prev"
        say "Hecho: la app de Inicio vuelve a ser $prev."
      else
        hist home "no se pudo devolver la app de Inicio a $prev: $(echo "$res" | tr '\n' ' ' | cut -c1-100)"
        die "no se pudo: tras add-role-holder el titular es «${now:-desconocido}». Respuesta del sistema: ${res:-(vacía)}. Elige el launcher a mano en Ajustes."
      fi
      ;;
    *) usage 2 ;;
  esac
}

kv() { echo "$1=$2"; }

# Estado en líneas clave=valor: lo lee el WebUI del módulo (webroot/index.html).
show_state() {
  kv module_version "$(sed -n 's/^version=//p' "$MODDIR/module.prop" 2>/dev/null | head -n 1)"
  kv boot_completed "$(boot_completed && echo 1 || echo 0)"
  kv enabled "$([ -f "$STATE_DIR/enabled" ] && echo 1 || echo 0)"
  kv overlay_apk_in_module "$([ -f "$MODDIR/overlay-static/NexusRecentsOverlay.apk" ] && echo 1 || echo 0)"
  kv overlay_apk_applied "$([ -f "$OVERLAY_PATH" ] && echo 1 || echo 0)"
  kv current_recents "$(current_recents)"
  if overlay_effective; then
    kv effective 1
    kv bound "$(is_bound && echo 1 || echo 0)"
  else
    kv effective 0
    kv bound -
  fi
  kv healthy "$([ -e "$STATE_DIR/healthy" ] && echo 1 || echo 0)"
  kv booting "$([ -f "$STATE_DIR/booting" ] && echo 1 || echo 0)"
  kv tripped "$(cat "$STATE_DIR/tripped" 2>/dev/null | tr '\n' ' ')"
  kv tripped_kind "$(tripped_kind)"
  kv failed_boot "$([ -f "$FAILED_DIR/saved-at" ] && cat "$FAILED_DIR/saved-at" || echo 0)"
  # Nexus como app de sistema privilegiada (ver nexus_flags).
  nexus_flags
  system=$NX_SYSTEM
  priv=$NX_PRIV
  kv nexus_system "$system"
  kv nexus_privileged "$priv"
  kv nexus_in_product "$([ -f "$PRODUCT_DIR/priv-app/Nexus/Nexus.apk" ] && echo 1 || echo 0)"
  kv probe_passed "$(probe_value passed)"
  kv probe_denied "$(probe_value denied)"
  kv apk_bundled "$(bundled_version_code)"
  kv apk_sync "$(cat "$STATE_DIR/apk-sync" 2>/dev/null | tr '\n' ' ')"
  kv hybrid_umount "$(hybrid_value)"
  kv hybrid_changed "$([ -f "$HYBRID_MARK" ] && echo 1 || echo 0)"
  kv plan_a_failed "$([ -f "$STATE_DIR/plan-a-failed" ] && echo 1 || echo 0)"
}

section() { echo; echo "=== $1 ==="; }

build_diag() {
  echo "Nexus Launcher: diagnóstico del módulo"
  echo "fecha: $(date '+%Y-%m-%d %H:%M:%S')"
  section "Sistema"
  for p in ro.product.brand ro.product.device ro.build.fingerprint ro.build.version.sdk \
    ro.build.version.release ro.build.type ro.control_privapp_permissions ro.boot.vendor.overlay.static; do
    echo "$p=$(getprop "$p")"
  done
  section "Gestor de root"
  (ksud --version || magisk -v || apd --version) 2>&1 | head -n 3
  section "Módulo"
  cat "$MODDIR/module.prop" 2>/dev/null
  ls -laZ "$MODDIR" 2>&1 | head -n 30
  ls -laRZ "$MODDIR/system/product" 2>&1 | head -n 40
  section "Montajes de las particiones"
  grep -E ' /product | /system_ext | /vendor ' /proc/mounts 2>&1 | head -n 12
  section "Nexus (paquete)"
  pm path "$PKG" 2>&1
  dumpsys package "$PKG" 2>&1 | grep -E 'codePath|versionCode|versionName|pkgFlags|privateFlags|lastUpdateTime|installerPackageName' | head -n 24
  ls -laZ /product/priv-app/Nexus 2>&1
  section "Launcher de recientes de la ROM (para valorar sustituirlo)"
  rc=$(current_recents)
  echo "config_recentsComponentName: $rc"
  rpkg=${rc%%/*}
  if [ -n "$rpkg" ] && [ "$rpkg" != "$PKG" ]; then
    echo "paquete: $rpkg"
    pm path "$rpkg" 2>&1
    rpk=$(dumpsys package "$rpkg" 2>/dev/null)
    echo "$rpk" | grep -E 'codePath|versionName|versionCode|pkgFlags|privateFlags|primaryCpuAbi|nativeLibraryDir|legacyNativeLibraryDir|firstInstallTime|lastUpdateTime|installerPackageName|signatures|Signatures' | head -n 16
    echo "--- ¿tiene actualización en /data? (rutas del paquete)"
    pm path "$rpkg" 2>&1 | sed 's/^package://'
    for apk in $(pm path "$rpkg" 2>/dev/null | sed 's/^package://'); do
      d=$(dirname "$apk")
      echo "--- directorio $d"
      ls -laZ "$d" 2>&1 | head -n 20
      ls -la "$d/lib" "$d/oat" 2>&1 | head -n 12
    done
    echo "--- versión, ABI del dispositivo y datos del paquete"
    pm list packages --show-versioncode "$rpkg" 2>&1 | head -n 2
    echo "abilist=$(getprop ro.product.cpu.abilist) control_privapp_permissions=$(getprop ro.control_privapp_permissions) selinux=$(getenforce 2>&1)"
    ls -ldZ "/data/data/$rpkg" 2>&1
    echo "--- permisos privilegiados que la ROM ya permite a ese paquete"
    grep -l "package=\"$rpkg\"" /system/etc/permissions/*.xml /system_ext/etc/permissions/*.xml /product/etc/permissions/*.xml /vendor/etc/permissions/*.xml 2>/dev/null | head -n 5
  else
    echo "(el proveedor de recientes ya es Nexus o no se pudo leer)"
  fi
  echo "--- actividades de inicio (HOME) instaladas"
  cmd package query-activities --brief -a android.intent.action.MAIN -c android.intent.category.HOME 2>&1 | head -n 20
  echo "--- servicios QUICKSTEP en el sistema"
  cmd package query-services --brief -a android.intent.action.QUICKSTEP_SERVICE 2>&1 | head -n 10
  section "Lista de permisos privilegiados"
  ls -laZ /product/etc/permissions 2>&1 | grep -i nexus
  head -n 12 /product/etc/permissions/privapp-permissions-nexus.xml 2>&1
  section "Overlays"
  ls -laZ /product/overlay 2>&1 | head -n 40
  echo "config_recentsComponentName ahora: $(current_recents)"
  ls -la /product/overlay/config 2>&1 | head -n 5
  cmd overlay list 2>&1 | head -n 60
  section "Estado del módulo"
  show_state
  ls -laZ "$STATE_DIR" 2>&1
  tail -n 60 "$STATE_DIR/watchdog.log" 2>&1
  section "Último arranque fallido"
  if [ -f "$FAILED_DIR/saved-at" ]; then
    ls -la "$FAILED_DIR"
    [ -d "$FAILED_DIR/pstore" ] && ls -la "$FAILED_DIR/pstore"
    echo "--- líneas relevantes del registro ---"
    grep -h -i -E 'FATAL EXCEPTION|Missing required system package|privapp|allowlist|whitelist|Violation|SecurityException|nexus|recents|overlay' \
      "$FAILED_DIR"/logcat.log* 2>/dev/null | head -n 120
    echo "--- líneas relevantes de pstore ---"
    grep -a -h -i -E 'panic|Missing required|privapp|allowlist|nexus|overlay|Watchdog' \
      "$FAILED_DIR"/pstore/* 2>/dev/null | head -n 60
  else
    echo "No hay registro de un arranque fallido."
  fi
}

do_diag() {
  need_root
  mkdir -p "$STATE_DIR" 2>/dev/null
  build_diag > "$STATE_DIR/diag.txt" 2>&1
  if [ "$1" = "--export" ]; then
    mkdir -p "$EXPORT_DIR" 2>/dev/null
    out="$EXPORT_DIR/Nexus-diagnostico.tar.gz"
    rm -f "$out"
    files="diag.txt"
    for f in watchdog.log tripped failed-boot capture; do
      [ -e "$STATE_DIR/$f" ] && files="$files $f"
    done
    # shellcheck disable=SC2086
    if (cd "$STATE_DIR" && tar -czf "$out" $files 2>/dev/null) && [ -s "$out" ]; then
      chmod 0666 "$out" 2>/dev/null
      say "Exportado: $out"
    else
      rm -f "$out"
      if cp "$STATE_DIR/diag.txt" "$EXPORT_DIR/Nexus-diagnostico.txt" 2>/dev/null; then
        chmod 0666 "$EXPORT_DIR/Nexus-diagnostico.txt" 2>/dev/null
        say "Exportado: $EXPORT_DIR/Nexus-diagnostico.txt (sin los registros del arranque: no se pudo crear el .tar.gz)"
      else
        die "no se pudo escribir en $EXPORT_DIR"
      fi
    fi
    return 0
  fi
  cat "$STATE_DIR/diag.txt"
}

case "$1" in
  status) show_status ;;
  enable) shift; do_enable "$@" ;;
  umount-fix) do_umount_fix "$2" ;;
  preflight) do_preflight ;;
  sync-apk) do_sync_apk "$2" ;;
  history) do_history ;;
  hist-add) need_root; hist "$2" "$3" ;;
  disable) do_disable "$2" ;;
  bound) do_bound ;;
  state) need_root; show_state ;;
  diag) do_diag "$2" ;;
  logs) do_logs "${2:-0}" ;;
  capture)
    need_root
    case "$2" in
      start) capture_start ;;
      stop) capture_stop ;;
      keep) capture_keep ;;
      *) usage 2 ;;
    esac
    ;;
  home-role) do_home_role "$2" ;;
  guard) need_root; do_guard ;;
  -h | --help | help) usage 0 ;;
  *) usage 2 ;;
esac
