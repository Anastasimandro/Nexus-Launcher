<?xml version="1.0" encoding="utf-8"?>
<!--
  Entrada de la ventana de la app lanzada desde Nexus.

  Va sincronizada con el zoom del icono del launcher (resorte de apertura, rigidez 170 /
  amortiguación 0,90): la escala sigue la misma curva en 460 ms y el fundido empieza cuando el
  icono ya va por la mitad (~130 ms) y termina cuando está casi abierto (~330 ms).
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <alpha
        android:duration="200"
        android:fromAlpha="0"
        android:interpolator="@android:interpolator/decelerate_quad"
        android:startOffset="130"
        android:toAlpha="1" />
    <scale
        android:duration="460"
        android:fromXScale="0.94"
        android:fromYScale="0.94"
        android:interpolator="@interpolator/nexus_spring_open"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
