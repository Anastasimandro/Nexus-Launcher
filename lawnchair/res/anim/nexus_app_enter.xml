<?xml version="1.0" encoding="utf-8"?>
<!--
  Entrada de la ventana de la app lanzada desde Nexus.
  Aparece con un fundido corto mientras la hoja del launcher termina de crecer.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <alpha
        android:duration="170"
        android:fromAlpha="0"
        android:interpolator="@android:interpolator/decelerate_quad"
        android:startOffset="110"
        android:toAlpha="1" />
    <scale
        android:duration="400"
        android:fromXScale="0.94"
        android:fromYScale="0.94"
        android:interpolator="@interpolator/nexus_open"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
